{
  "rules": {
    ".read": false,
    ".write": false,

    "global_messages": {
      ".read": "auth != null",
      "$messageId": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid))",
        "uid": { ".validate": "newData.val() === auth.uid" },
        "sender": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "photoURL": { ".validate": "newData.isString() && newData.val().length <= 2048" },
        "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
        "message": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "timestamp": { ".validate": "newData.isNumber()" },
        "status": { ".validate": "newData.val() === 'sent'" },
        "deleted": { ".validate": "newData.isBoolean()" },
        "edited": { ".validate": "newData.isBoolean()" },
        "replyTo": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "replyToName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "replyToText": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "reactions": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.parent().parent().child('uid').exists()",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 8"
          }
        },
        "$other": { ".validate": false }
      }
    },

    "room_messages": {
      "$roomId": {
        ".read": "auth != null && root.child('room_members').child($roomId).child(auth.uid).exists()",
        "$messageId": {
          ".write": "auth != null && root.child('room_members').child($roomId).child(auth.uid).exists() && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid))",
          "uid": { ".validate": "newData.val() === auth.uid" },
          "sender": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "displayName": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "photoURL": { ".validate": "newData.isString() && newData.val().length <= 2048" },
          "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
          "message": { ".validate": "newData.isString() && newData.val().length <= 2000" },
          "timestamp": { ".validate": "newData.isNumber()" },
          "status": { ".validate": "newData.val() === 'sent'" },
          "deleted": { ".validate": "newData.isBoolean()" },
          "edited": { ".validate": "newData.isBoolean()" },
          "replyTo": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "replyToName": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "replyToText": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "reactions": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('room_members').child($roomId).child(auth.uid).exists() && newData.parent().parent().child('uid').exists()",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 8"
            }
          },
          "$other": { ".validate": false }
        }
      }
    },

    "room_members": {
      ".read": "auth != null",
      "$roomId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === true"
        }
      }
    },

    "typing": {
      "global": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['uid', 'displayName'])",
          "uid": { ".validate": "newData.val() === auth.uid" },
          "displayName": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "timestamp": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "rooms": {
        "$roomId": {
          ".read": "auth != null && root.child('room_members').child($roomId).child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('room_members').child($roomId).child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['uid', 'displayName'])",
            "uid": { ".validate": "newData.val() === auth.uid" },
            "displayName": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "timestamp": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "online": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "photoURL": { ".validate": "newData.isString() && newData.val().length <= 2048" },
        "lastOnline": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
